<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Put Clover actions in the More/Actions dialog (showRemainingButtons),
        same place as Pricelist / Refund — not the main control strip.
    -->
    <t t-name="pos_neatclover.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="showNeatCloverSyncDeviceButton"
                    t-att-class="buttonClass"
                    t-on-click="() => this.onClickNeatCloverSyncDevice()">
                <i class="fa fa-tablet me-1" role="img" aria-label="Sync Device" title="Sync Device"/>
                Sync Device
            </button>
            <button t-if="showNeatCloverPreAuthButton"
                    t-att-class="buttonClass"
                    t-on-click="() => this.onClickNeatCloverPreAuth()">
                <i class="fa fa-credit-card me-1" role="img" aria-label="Clover Pre-Auth" title="Clover Pre-Auth"/>
                Clover Pre-Auth
            </button>
        </xpath>
    </t>
</templates>

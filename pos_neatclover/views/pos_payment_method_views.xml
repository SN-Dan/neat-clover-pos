<odoo>
    <record id="pos_payment_method_view_form_inherit_neat_clover" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.neatclover</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="neat_clover_terminal_device_code"
                       attrs="{'invisible': [('use_payment_terminal', '!=', 'neatclover')],
                                'readonly': [('use_payment_terminal', '=', 'neatclover')]}"/>
                <field name="neat_clover_terminal_master_pwd_mock" password="True"
                       attrs="{'invisible': [('use_payment_terminal', '!=', 'neatclover')]}">
                </field>
                <field name="neat_clover_terminal_manager_group_selection" attrs="{'invisible': [('use_payment_terminal', '!=', 'neatclover')],
                                'required': [('use_payment_terminal', '=', 'neatclover')]}"/>
                <field name="neat_clover_device_type" attrs="{'invisible': [('use_payment_terminal', '!=', 'neatclover')],
                                'required': [('use_payment_terminal', '=', 'neatclover')]}"/>
                <field name="neat_clover_is_mobile" attrs="{'invisible': [('use_payment_terminal', '!=', 'neatclover')]}"/>
                <field name="neat_clover_self_signed_certificates" attrs="{'invisible': [('use_payment_terminal', '!=', 'neatclover')]}"/>
                <field name="neat_clover_is_desktop_mode" attrs="{'invisible': [('use_payment_terminal', '!=', 'neatclover')]}"/>
<div class="alert alert-success" role="alert" colspan="2"
                     attrs="{'invisible': ['|', ('use_payment_terminal', '!=', 'neatclover'), ('neat_clover_desktop_api_key', '!=', False)]}">
                    Don't have an Activation Code yet?<br/>
                    
                    <a href="https://api.sns-software.com/license-request?provider=clover" target="_blank" rel="noopener noreferrer">
                        Get a free activation code
                    </a>
                </div>
                <field name="neat_clover_desktop_api_key" password="True"
                    attrs="{
                        'invisible': [('use_payment_terminal', '!=', 'neatclover')],
                        'required': [('use_payment_terminal', '=', 'neatclover')]
                    }"/>
                <field name="neat_clover_is_local_ws_server" attrs="{'invisible': [('use_payment_terminal', '!=', 'neatclover')], 'readonly': [('neat_clover_is_desktop_mode', '!=', True)]}"/>
                <field name="neat_clover_is_readonly" invisible="1"/>
                <field name="neat_clover_ws_url"
                    attrs="{
                        'invisible': [('use_payment_terminal', '!=', 'neatclover')],
                        'readonly': [('neat_clover_is_readonly', '=', True)]
                    }"/>
                <field name="neat_clover_is_terminal_printer_communication_allowed"
                    attrs="{
                        'invisible': [('use_payment_terminal', '!=', 'neatclover')],
                        'readonly': [('neat_clover_is_desktop_mode', '!=', True)]
                    }"/>
                <div class="alert alert-success" role="alert" colspan="2"
                     attrs="{'invisible': [('use_payment_terminal', '!=', 'neatclover')]}">
                    <b>By using this module you agree to our </b>
                    
                    <a href="https://api.sns-software.com/terms-and-conditions?provider=clover" target="_blank" rel="noopener noreferrer">
                        terms and conditions
                    </a>
                    <b> and </b>
                    <a href="https://api.sns-software.com/privacy?provider=clover" target="_blank" rel="noopener noreferrer">
                        privacy policy
                    </a>
                </div>
                    </xpath>
        </field>
    </record>
</odoo>

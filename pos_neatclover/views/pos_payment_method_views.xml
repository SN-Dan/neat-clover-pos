<odoo>
    <record id="pos_payment_method_view_form_inherit_neat_clover" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.neatclover</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="neat_clover_terminal_device_code" invisible="use_payment_terminal != 'neatclover'"
                                readonly="use_payment_terminal == 'neatclover'"/>
                <field name="neat_clover_terminal_master_pwd_mock" password="True"
                       invisible="use_payment_terminal != 'neatclover'">
                </field>
                <field name="neat_clover_terminal_manager_group_selection" invisible="use_payment_terminal != 'neatclover'"
                                required="use_payment_terminal == 'neatclover'"/>
                <field name="neat_clover_device_type" invisible="use_payment_terminal != 'neatclover'"
                                required="use_payment_terminal == 'neatclover'"/>
                <field name="neat_clover_is_mobile" invisible="use_payment_terminal != 'neatclover'"/>
                <field name="neat_clover_self_signed_certificates" invisible="use_payment_terminal != 'neatclover'"/>
                <field name="neat_clover_is_desktop_mode" invisible="use_payment_terminal != 'neatclover'"/>
                <script type="text/javascript" src="/pos_neatclover/static/src/js/neatclover_activation.js"/>
                <link rel="stylesheet" href="/pos_neatclover/static/src/css/neatclover_activation.css"/>
                <div class="alert alert-success" role="alert" colspan="2"
                     invisible="use_payment_terminal != 'neatclover' or neat_clover_desktop_api_key">
                    Don't have an Activation Code yet?<br/>
                    <a href="#" name="activation-code-button" onclick="showActivationForm(event)">
                        Get a free activation code
                    </a>
                    <div id="neatclover_form" class="neatclover-popup">
                        <h3>Request an Activation Code</h3>
                        <div id="neatclover_request_form">

                        </div>
                        <a href="#" class="neatclover_submit" name="neatclover_submit">Submit</a>
                        <a href="#" class="neatclover_close_form" name="neatclover_close_form">Cancel</a>
                    </div>
                </div>
                <field name="neat_clover_desktop_api_key" password="True"
                       invisible="use_payment_terminal != 'neatclover'"
                       required="use_payment_terminal == 'neatclover'"/>
                <field name="neat_clover_is_local_ws_server" invisible="use_payment_terminal != 'neatclover'" readonly="neat_clover_is_desktop_mode != True" />
                <field name="neat_clover_ws_url" invisible="use_payment_terminal != 'neatclover'" readonly="neat_clover_is_local_ws_server != True or neat_clover_is_desktop_mode != True"/>
                <field name="neat_clover_is_terminal_printer_communication_allowed" invisible="use_payment_terminal != 'neatclover'" readonly="neat_clover_is_desktop_mode != True"/>
                <div class="alert alert-success" role="alert" colspan="2"
                     invisible="use_payment_terminal != 'neatclover'">
                    <b>By using this module you agree to our </b>
                    <a href="#" onclick="showTermsPopup(event)">
                        terms and conditions
                    </a>
                    <div id="neatclover_terms_popup" class="neatclover-popup neatclover-terms-popup">
                        <h3>Terms and Conditions</h3>
                        <div id="neatclover_terms_content" class="neatclover-terms-content">
                            Loading...
                        </div>
                        <a href="#" class="neatclover_close_terms" name="neatclover_close_terms">Close</a>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
